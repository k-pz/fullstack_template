{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "build": "bun run build.ts",
    "typecheck": "bun check",
    "lint": "oxlint --deny-warnings",
    "lint-fix": "oxlint --deny-warnings --fix",
    "format": "oxfmt",
    "format-check": "oxfmt --check",
    "test": "bun test",
    "all": "bun run format && bun run lint-fix && bun run typecheck && bun run test",
    "verify": "bun run format-check && bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.1.11"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
